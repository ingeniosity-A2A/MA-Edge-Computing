+void fapo_control_server::run()
+{
+  // Parse the endpoint.
+  std::string endpoint = cfg.endpoint;
+  if (endpoint.rfind("tcp://", 0) == 0) {
+    std::string rest = endpoint.substr(6);
+    auto        sep  = rest.rfind(':');
+    if (sep == std::string::npos) {
+      logger.error("FAPO control server: invalid tcp endpoint \"{}\"", endpoint);
+      return;
+    }
+    std::string host    = rest.substr(0, sep);
+    unsigned    port    = 0;
+    try {
+      port = static_cast<unsigned>(std::stoul(rest.substr(sep + 1)));
+    } catch (const std::exception&) {
+      logger.error("FAPO control server: invalid port in endpoint \"{}\"", endpoint);
+      return;
+    }
+    if (not cfg.allow_remote and host != "127.0.0.1" and host != "localhost" and host != "::1") {
+      // Defense in depth: the validator already rejects this configuration.
+      logger.error("FAPO control server: refusing to listen on non-loopback address \"{}\" (allow_remote=false)", host);
+      return;
+    }
+    listen_fd = open_listen_tcp(host.c_str(), port, logger);
+  } else if (endpoint.rfind("unix:///", 0) == 0) {
+    unix_sock_path = endpoint.substr(7);
+    listen_fd      = open_listen_unix(unix_sock_path.c_str(), logger);
+  } else {
+    logger.error("FAPO control server: unsupported endpoint \"{}\"", endpoint);
+    return;
+  }
+  if (listen_fd < 0) {
+    return;
+  }
+
+  // The listen socket must be non-blocking, otherwise accept() can block the server loop
+  // (and the server thread shutdown) indefinitely.
+  {
+    int flags = ::fcntl(listen_fd, F_GETFL, 0);
+    ::fcntl(listen_fd, F_SETFL, flags | O_NONBLOCK);
+  }
+
+  // Server loop state.
+  std::array<client_state, 16>          clients;
+  std::array<struct pollfd, 16 + 1>     pfds;
+  const unsigned                        max_clients = std::min<unsigned>(clients.size(), cfg.max_clients);
+
+  while (not stop_flag.load(std::memory_order_acquire)) {
+    nfds_t nfds = 0;
+    pfds[nfds].fd      = listen_fd;
+    pfds[nfds].events  = POLLIN;
+    pfds[nfds].revents = 0;
+    ++nfds;
+    for (unsigned i = 0; i != max_clients; ++i) {
+      if (clients[i].fd < 0) {
+        continue;
+      }
+      short ev = POLLIN;
+      if (not clients[i].outbuf.empty()) {
+        ev |= POLLOUT;
+      }
+      pfds[nfds].fd      = clients[i].fd;
+      pfds[nfds].events  = ev;
+      pfds[nfds].revents = 0;
+      ++nfds;
+    }
+
+    int pret = ::poll(pfds.data(), nfds, 200);
+    if (pret < 0) {
+      if (errno == EINTR) {
+        continue;
+      }
+      logger.error("FAPO control server: poll failed. Cause: {}", strerror(errno));
+      break;
+    }
+    if (pret == 0) {
+      continue;
+    }
+
+    // Handle readable listen socket (accept new clients).
+    if (pfds[0].revents & POLLIN) {
+      while (true) {
+        int cfd = ::accept(listen_fd, nullptr, nullptr);
+        if (cfd < 0) {
+          if (errno == EAGAIN or errno == EWOULDBLOCK) {
+            break;
+          }
+          logger.error("FAPO control server: accept failed. Cause: {}", strerror(errno));
+          break;
+        }
+        int slot = -1;
+        for (unsigned i = 0; i != max_clients and slot < 0; ++i) {
+          if (clients[i].fd < 0) {
+            slot = static_cast<int>(i);
+          }
+        }
+        if (slot < 0) {
+          logger.warning("FAPO control server: rejecting incoming connection. Cause: too many clients");
+          ::close(cfd);
+          continue;
+        }
+        // Non-blocking socket.
+        int flags = ::fcntl(cfd, F_GETFL, 0);
+        ::fcntl(cfd, F_SETFL, flags | O_NONBLOCK);
+        int one = 1;
+        ::setsockopt(cfd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+        clients[slot].fd     = cfd;
+        clients[slot].inbuf.clear();
+        clients[slot].outbuf.clear();
+        logger.info("FAPO control server: client connected");
+      }
+    }
+
+    // Handle client sockets.
+    for (unsigned i = 0; i != max_clients; ++i) {
+      client_state& cl = clients[i];
+      if (cl.fd < 0) {
+        continue;
+      }
+      struct pollfd* pe = nullptr;
+      for (nfds_t j = 1; j != nfds; ++j) {
+        if (pfds[j].fd == cl.fd) {
+          pe = &pfds[j];
+          break;
+        }
+      }
+      if (pe == nullptr) {
+        continue;
+      }
+
+      bool close_client = (pe->revents & (POLLHUP | POLLERR | POLLNVAL)) != 0;
+
+      if ((pe->revents & POLLIN) != 0 and not close_client) {
+        char buf[4096];
+        while (true) {
+          ssize_t n = ::recv(cl.fd, buf, sizeof(buf), MSG_DONTWAIT);
+          if (n < 0) {
+            if (errno == EAGAIN or errno == EWOULDBLOCK) {
+              break;
+            }
+            close_client = true;
+            break;
+          }
+          if (n == 0) {
+            close_client = true;
+            break;
+          }
+          cl.inbuf.append(buf, static_cast<size_t>(n));
+          if (cl.inbuf.size() > FAPO_MAX_LINE_SIZE) {
+            logger.warning("FAPO control server: client request line too long, disconnecting");
+            close_client = true;
+            break;
+          }
+          // Extract and process complete lines.
+          size_t pos = 0;
+          while (not close_client) {
+            size_t nl = cl.inbuf.find('\n', pos);
+            if (nl == std::string::npos) {
+              break;
+            }
+            std::string line = cl.inbuf.substr(pos, nl - pos);
+            pos              = nl + 1;
+            bool do_close    = false;
+            std::string resp = handle_line(line, do_close);
+            resp.push_back('\n');
+            cl.outbuf.append(resp);
+            close_client = do_close;
+          }
+          cl.inbuf.erase(0, pos);
+          if (close_client) {
+            break;
+          }
+        }
+      }
+
+      if ((pe->revents & POLLOUT) != 0 and not close_client and not cl.outbuf.empty()) {
+        ssize_t n = ::send(cl.fd, cl.outbuf.data(), cl.outbuf.size(), MSG_NOSIGNAL | MSG_DONTWAIT);
+        if (n < 0) {
+          if (errno != EAGAIN and errno != EWOULDBLOCK) {
+            close_client = true;
+          }
+        } else {
+          cl.outbuf.erase(0, static_cast<size_t>(n));
+        }
+      }
+
+      if (close_client) {
+        ::close(cl.fd);
+        cl.fd = -1;
+        logger.info("FAPO control server: client disconnected");
+      }
+    }
+  }
+
+  for (auto& cl : clients) {
+    if (cl.fd >= 0) {
+      ::close(cl.fd);
+      cl.fd = -1;
+    }
+  }
+  ::close(listen_fd);
+  listen_fd = -1;
+  if (not unix_sock_path.empty()) {
+    ::unlink(unix_sock_path.c_str());
+  }
+  logger.info("FAPO control server: stopped");
+}
+
+std::string fapo_control_server::handle_line(const std::string& line, bool& close_client)
+{
+  close_client = false;
+
+  // Parse the request. A malformed line is answered with a bad_request error and a null id.
+  jval req;
+  {
+    std::string nul_terminated = line;
+    jparser     parser{nul_terminated.c_str(), nul_terminated.c_str() + nul_terminated.size()};
+    if (!parser.parse(req)) {
+      fmt::memory_buffer buf;
+      fmt::format_to(fmt::appender(buf), "{{\"v\":{},\"id\":null,\"ok\":false,\"error\":{{\"code\":\"bad_request\","
+                                        "\"message\":\"line is not valid JSON\"}}}}",
+                     FAPO_PROTOCOL_VERSION);
+      return fmt::to_string(buf);
+    }
+  }
+
+  const jval* vid  = req.find("v");
+  const jval* vidn = req.find("id");
+  const jval* vop  = req.find("op");
+
+  double req_id = (vidn != nullptr and vidn->type == jval::type_t::number) ? vidn->num : 0;
+
+  // Helper lambdas to build responses.
+  auto make_error = [&](const char* code, const std::string& message) {
+    fmt::memory_buffer buf;
+    fmt::format_to(fmt::appender(buf), "{{\"v\":{},\"id\":", FAPO_PROTOCOL_VERSION);
+    fmt_request_id(buf, req_id);
+    fmt::format_to(fmt::appender(buf), ",\"ok\":false,\"error\":{{\"code\":\"{}\",\"message\":", code);
+    json_escape(buf, message);
+    fmt::format_to(fmt::appender(buf), "}}}}");
+    return fmt::to_string(buf);
+  };
+  auto make_ok_prefix = [&]() {
+    fmt::memory_buffer buf;
+    fmt::format_to(fmt::appender(buf), "{{\"v\":{},\"id\":", FAPO_PROTOCOL_VERSION);
+    fmt_request_id(buf, req_id);
+    fmt::format_to(fmt::appender(buf), ",\"ok\":true,");
+    return buf;
+  };
+
+  if (vid == nullptr or vid->type != jval::type_t::number or static_cast<unsigned>(vid->num) != FAPO_PROTOCOL_VERSION) {
+    return make_error("version_mismatch", "unsupported protocol version");
+  }
+  if (vop == nullptr or vop->type != jval::type_t::str) {
+    return make_error("bad_request", "missing or invalid \"op\" field");
+  }
+
+  const std::string& op = vop->str;
+
+  if (op == "hello") {
+    auto buf = make_ok_prefix();
+    fmt::format_to(fmt::appender(buf), "\"server\":\"{}\",\"protocol\":{},\"capabilities\":[\"telemetry\",\"apply\","
+                                      "\"reset\"]}}",
+                   FAPO_SERVER_NAME,
+                   FAPO_PROTOCOL_VERSION);
+    return fmt::to_string(buf);
+  }
+  if (op == "ping") {
+    auto buf = make_ok_prefix();
+    fmt::format_to(fmt::appender(buf), "\"pong\":true}}");
+    return fmt::to_string(buf);
+  }
+  if (op == "get_telemetry") {
+    auto buf = make_ok_prefix();
+    std::string tel = build_telemetry_json();
+    buf.append(tel.data(), tel.data() + tel.size());
+    fmt::format_to(fmt::appender(buf), "}}");
+    return fmt::to_string(buf);
+  }
+  if (op == "reset") {
+    // Enqueue one reset command per active cell.
+    fapo_cell_snapshot snap;
+    unsigned           nof_cells = 0;
+    for (unsigned cell_idx = 0; cell_idx != MAX_NOF_DU_CELLS; ++cell_idx) {
+      if (ctx.telemetry.read(to_du_cell_index(cell_idx), snap) and snap.active) {
+        fapo_command cmd;
+        cmd.cell_index = to_du_cell_index(cell_idx);
+        cmd.reset      = true;
+        if (not ctx.commands.try_push(cmd)) {
+          logger.warning("FAPO control server: command queue full, dropping reset command");
+        } else {
+          ++nof_cells;
+        }
+      }
+    }
+    if (nof_cells == 0) {
+      return make_error("not_ready", "no active cell telemetry available");
+    }
+    logger.info("FAPO control server: requested reset of baseline policies for {} cell(s)", nof_cells);
+    auto buf = make_ok_prefix();
+    fmt::format_to(fmt::appender(buf), "\"mode\":\"baseline\"}}");
+    return fmt::to_string(buf);
+  }
+  if (op == "apply") {
+    // Read the latest merged snapshot to resolve slice names to slice ids and to clamp the requests.
+    fapo_cell_snapshot merged;
+    unsigned           nof_active_cells = 0;
+    if (not read_merged_snapshot(merged, nof_active_cells)) {
+      return make_error("not_ready", "no cell telemetry available yet");
+    }
+
+    // Local mapping of slice name -> (cell index, slice id) of the merged snapshot.
+    struct named_slice {
+      std::string    name;
+      du_cell_index_t cell;
+      ran_slice_id_t  id;
+      unsigned        max_prbs;
+    };
+    static_vector<named_slice, FAPO_MAX_SLICES * MAX_NOF_DU_CELLS> slice_index;
+    {
+      bool single_cell = nof_active_cells <= 1;
+      // Recompute the names exactly like build_telemetry_json does.
+      unsigned active_seen = 0;
+      for (unsigned cell_idx = 0; cell_idx != MAX_NOF_DU_CELLS; ++cell_idx) {
+        fapo_cell_snapshot snap;
+        if (not ctx.telemetry.read(to_du_cell_index(cell_idx), snap) or not snap.active) {
+          continue;
+        }
+        ++active_seen;
+        for (unsigned i = 0; i != snap.nof_slices; ++i) {
+          const fapo_slice_snapshot& s = snap.slices[i];
+          named_slice&               e = slice_index.emplace_back();
+          e.cell                       = to_du_cell_index(cell_idx);
+          e.id                         = s.id;
+          e.max_prbs                   = snap.prbs_total;
+          if (single_cell) {
+            e.name.assign(s.name.data());
+          } else {
+            e.name = fmt::format("c{}/{}", cell_idx, s.name.data());
+          }
+        }
+      }
+    }
+
+    fmt::memory_buffer applied;
+    fmt::memory_buffer rejected;
+    const jval*        vactions = req.find("actions");
+    if (vactions != nullptr and vactions->type == jval::type_t::arr) {
+      bool first_applied = true;
+      bool first_rejected = true;
+      for (const jval& act : vactions->arr) {
+        if (act.type != jval::type_t::obj) {
+          continue;
+        }
+        const jval* vsid  = act.find("slice_id");
+        const jval* vprbs = act.find("prbs");
+        const jval* vpw   = act.find("tx_power_dbm");
+
+        if (vsid == nullptr or vsid->type != jval::type_t::str) {
+          fmt::format_to(fmt::appender(rejected), "{}{{\"slice_id\":null,\"reason\":\"malformed_action\"}}",
+                         first_rejected ? "" : ",");
+          first_rejected = false;
+          continue;
+        }
+        const std::string& sid = vsid->str;
+
+        const named_slice* found = nullptr;
+        for (const auto& e : slice_index) {
+          if (e.name == sid) {
+            found = &e;
+            break;
+          }
+        }
+        if (found == nullptr) {
+          fmt::memory_buffer rbuf;
+          fmt::format_to(fmt::appender(rbuf), "{}{{\"slice_id\":", first_rejected ? "" : ",");
+          json_escape(rbuf, sid);
+          fmt::format_to(fmt::appender(rbuf), ",\"reason\":\"unknown_slice\"}}");
+          rejected.append(rbuf.data(), rbuf.data() + rbuf.size());
+          first_rejected = false;
+          continue;
+        }
+        if (vprbs == nullptr or vprbs->type != jval::type_t::number or vprbs->num < 1 or vprbs->num > 1e9) {
+          fmt::memory_buffer rbuf;
+          fmt::format_to(fmt::appender(rbuf), "{}{{\"slice_id\":", first_rejected ? "" : ",");
+          json_escape(rbuf, sid);
+          fmt::format_to(fmt::appender(rbuf), ",\"reason\":\"malformed_action\"}}");
+          rejected.append(rbuf.data(), rbuf.data() + rbuf.size());
+          first_rejected = false;
+          continue;
+        }
+
+        // Clamp the requested maximum number of RBs to the cell capacity.
+        unsigned prbs = static_cast<unsigned>(vprbs->num);
+        prbs          = std::min(std::max(prbs, 1U), found->max_prbs);
+
+        fapo_command cmd;
+        cmd.cell_index = found->cell;
+        cmd.slice_id   = found->id;
+        cmd.max_rbs    = prbs;
+        if (not ctx.commands.try_push(cmd)) {
+          logger.warning("FAPO control server: command queue full, dropping apply command");
+        }
+
+        double power = 0;
+        if (vpw != nullptr and vpw->type == jval::type_t::number) {
+          power = std::min(std::max(vpw->num, 0.0), 100.0);
+        }
+        fmt::memory_buffer abuf;
+        fmt::format_to(fmt::appender(abuf), "{}{{\"slice_id\":", first_applied ? "" : ",");
+        json_escape(abuf, sid);
+        fmt::format_to(fmt::appender(abuf), ",\"prbs\":{},\"tx_power_dbm\":{:.2f}}}", prbs, power);
+        applied.append(abuf.data(), abuf.data() + abuf.size());
+        first_applied = false;
+      }
+    }
+
+    auto buf = make_ok_prefix();
+    fmt::format_to(fmt::appender(buf), "\"applied\":[");
+    buf.append(applied.data(), applied.data() + applied.size());
+    fmt::format_to(fmt::appender(buf), "],\"rejected\":[");
+    buf.append(rejected.data(), rejected.data() + rejected.size());
+    fmt::format_to(fmt::appender(buf), "]}}");
+    return fmt::to_string(buf);
+  }
+
+  return make_error("unknown_op", fmt::format("unknown op \"{}\"", op));
+}
+
+std::string fapo_control_server::build_telemetry_json()
+{
+  fmt::memory_buffer buf;
+
+  double ts = std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();
+
+  fapo_cell_snapshot primary;
+  bool               has_primary      = false;
+  unsigned           nof_active_cells = 0;
+  for (unsigned cell_idx = 0; cell_idx != MAX_NOF_DU_CELLS; ++cell_idx) {
+    fapo_cell_snapshot snap;
+    if (ctx.telemetry.read(to_du_cell_index(cell_idx), snap) and snap.active) {
+      ++nof_active_cells;
+      if (not has_primary) {
+        primary     = snap;
+        has_primary = true;
+      }
+    }
+  }
+
+  fmt::format_to(fmt::appender(buf), "\"ts\":{:.3f},", ts);
+
+  if (not has_primary) {
+    // No cell has published telemetry yet.
+    fmt::format_to(fmt::appender(buf),
+                   "\"cell\":{{\"prbs_total\":0,\"available_prbs\":0,\"throughput_mbps\":0.0,\"latency_ms\":0.0,"
+                   "\"packet_loss\":0.0,\"tx_power_dbm\":{:.1f},\"spectral_efficiency\":0.0}},",
+                   static_cast<double>(cfg.nominal_tx_power_dbm));
+    fmt::format_to(fmt::appender(buf), "\"slices\":{{}},\"policies\":{{}}");
+    return fmt::to_string(buf);
+  }
+
+  // Derived cell metrics.
+  double   cell_used_rbs   = 0;
+  double   worst_latency   = 0;
+  double   max_queue_pct   = 0;
+  uint64_t acks            = primary.nof_dl_harq_acks;
+  uint64_t nacks           = primary.nof_dl_harq_nacks;
+
+  const double slots_per_sec = static_cast<double>(primary.slots_per_sec);
+  const double bytes_per_rb_slot = static_cast<double>(cfg.tb_bytes_per_rb_slot);
+
+  fmt::format_to(fmt::appender(buf), "\"slices\":{{");
+  bool first_slice = true;
+  for (unsigned i = 0; i != primary.nof_slices; ++i) {
+    const fapo_slice_snapshot& s = primary.slices[i];
+    const double avg_rbs        = static_cast<double>(s.avg_dl_rbs_per_slot) + static_cast<double>(s.avg_ul_rbs_per_slot);
+    const unsigned used_rbs     = static_cast<unsigned>(avg_rbs + 0.5);
+    const unsigned pend_bytes   = s.pending_dl_bytes + s.pending_ul_bytes;
+    const double   queue_pct    = 100.0 * std::min(1.0, static_cast<double>(pend_bytes) / static_cast<double>(cfg.queue_ref_bytes));
+    const double   drain_bps    = avg_rbs * bytes_per_rb_slot * slots_per_sec;
+    const double   latency_ms   = pend_bytes == 0 ? 0.0
+                                              : static_cast<double>(pend_bytes) / std::max(drain_bps, bytes_per_rb_slot) * 1000.0;
+
+    if (not first_slice) {
+      buf.push_back(',');
+    }
+    first_slice = false;
+    fmt::format_to(fmt::appender(buf), "\"{}\":{{\"queue_depth\":{:.2f},\"latency_ms\":{:.2f},\"prbs_used\":{},"
+                                      "\"packet_loss\":0.0}}",
+                   s.name.data(),
+                   queue_pct,
+                   latency_ms,
+                   used_rbs);
+
+    cell_used_rbs += avg_rbs;
+    worst_latency = std::max(worst_latency, latency_ms);
+    max_queue_pct = std::max(max_queue_pct, queue_pct);
+  }
+  fmt::format_to(fmt::appender(buf), "}},");
+
+  const double throughput_mbps = cell_used_rbs * bytes_per_rb_slot * slots_per_sec * 8.0 / 1e6;
+  const double packet_loss =
+      (acks + nacks) > 0 ? static_cast<double>(nacks) / static_cast<double>(acks + nacks) : 0.0;
+  const double se =
+      primary.scs_khz > 0
+          ? (throughput_mbps * 1e6) / (static_cast<double>(primary.prbs_total) * 12.0 *
+                                       static_cast<double>(primary.scs_khz) * 1000.0)
+          : 0.0;
+  const long available_prbs = std::max(0L, static_cast<long>(primary.prbs_total) - static_cast<long>(cell_used_rbs + 0.5));
+
+  fmt::format_to(fmt::appender(buf),
+                 "\"cell\":{{\"prbs_total\":{},\"available_prbs\":{},\"throughput_mbps\":{:.2f},\"latency_ms\":{:.2f},"
+                 "\"packet_loss\":{:.5f},\"tx_power_dbm\":{:.1f},\"spectral_efficiency\":{:.2f}}},",
+                 primary.prbs_total,
+                 available_prbs,
+                 throughput_mbps,
+                 worst_latency,
+                 packet_loss,
+                 static_cast<double>(cfg.nominal_tx_power_dbm),
+                 se);
+
+  // Effective slice policies (radio remains the source of truth).
+  fmt::format_to(fmt::appender(buf), "\"policies\":{{");
+  first_slice = true;
+  for (unsigned i = 0; i != primary.nof_slices; ++i) {
+    const fapo_slice_snapshot& s = primary.slices[i];
+    if (not first_slice) {
+      buf.push_back(',');
+    }
+    first_slice = false;
+    fmt::format_to(fmt::appender(buf),
+                   "\"{}\":{{\"slice_type\":\"{}\",\"min_prbs\":{},\"max_prbs\":{},\"max_latency_ms\":{},"
+                   "\"max_power_dbm\":{:.1f},\"priority\":{}}}",
+                   s.name.data(),
+                   fapo_slice_type_of_sst(s.sst),
+                   s.min_prbs,
+                   s.max_prbs,
+                   cfg.max_latency_ms,
+                   static_cast<double>(cfg.nominal_tx_power_dbm),
+                   s.priority);
+  }
+  fmt::format_to(fmt::appender(buf), "}}");
+
+  return fmt::to_string(buf);
+}
+
+bool fapo_control_server::read_merged_snapshot(fapo_cell_snapshot& merged, unsigned& nof_active_cells)
+{
+  nof_active_cells = 0;
+  for (unsigned cell_idx = 0; cell_idx != MAX_NOF_DU_CELLS; ++cell_idx) {
+    fapo_cell_snapshot snap;
+    if (ctx.telemetry.read(to_du_cell_index(cell_idx), snap) and snap.active) {
+      if (nof_active_cells == 0) {
+        merged = snap;
+      }
+      ++nof_active_cells;
+    }
+  }
+  return nof_active_cells > 0;
+}
+
