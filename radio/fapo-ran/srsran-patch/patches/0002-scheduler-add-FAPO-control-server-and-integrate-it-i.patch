+namespace srsran {
+
+/// Maximum number of slices reported in a FAPO telemetry snapshot.
+/// \remark 16 configured RRM policy members (see \c MAX_SLICE_RECONF_POLICIES) + default SRB slice + default DRB slice.
+constexpr unsigned FAPO_MAX_SLICES = MAX_SLICE_RECONF_POLICIES + 2;
+
+/// Maximum number of pending FAPO control commands drained per slot.
+constexpr unsigned FAPO_MAX_CMDS_PER_SLOT = 32;
+
+/// \brief Snapshot of the FAPO-relevant state of one RAN slice.
+///
+/// All the fields are filled from the real scheduler state (see \c inter_slice_scheduler::fapo_collect_cell_snapshot).
+struct fapo_slice_snapshot {
+  /// RAN slice identifier (as used by the scheduler internally).
+  ran_slice_id_t id{};
+  /// Human-readable slice identifier exposed over the control protocol (e.g. "srb", "default", "sst2-sd0xa").
+  std::array<char, 24> name{};
+  /// Slice scheduling priority (0..255).
+  unsigned priority = 0;
+  /// Current RB limits of the slice (they change when FAPO applies new policies).
+  unsigned min_prbs       = 0;
+  unsigned max_prbs       = 0;
+  unsigned dedicated_prbs = 0;
+  /// Number of UEs with at least one bearer in this slice.
+  unsigned nof_ues = 0;
+  /// Sum of DL/UL pending bytes of all UEs of this slice (RLC/BSR reported queues).
+  unsigned pending_dl_bytes = 0;
+  unsigned pending_ul_bytes = 0;
+  /// EWMA of the number of PDSCH/PUSCH RBs granted per slot for this slice.
+  float avg_dl_rbs_per_slot = 0.0F;
+  float avg_ul_rbs_per_slot = 0.0F;
+  /// S-NSSAI SST of the slice RRM policy member (0 for the reserved default slices).
+  uint8_t sst = 0;
+};
+
+/// \brief Snapshot of the FAPO-relevant state of one cell, published by the slot thread.
+struct fapo_cell_snapshot {
+  bool     active     = false;
+  pci_t    pci        = 0;
+  unsigned prbs_total = 0;
+  /// Number of slots per second and SCS of the cell, used to derive service rates.
+  unsigned slots_per_sec = 0;
+  unsigned scs_khz       = 0;
+  /// Cumulative DL HARQ outcome counters of the cell (real packet loss proxy).
+  uint64_t nof_dl_harq_acks  = 0;
+  uint64_t nof_dl_harq_nacks = 0;
+  unsigned nof_slices        = 0;
+  std::array<fapo_slice_snapshot, FAPO_MAX_SLICES> slices{};
+};
+
+/// \brief Lock-free telemetry store exchanged between the scheduler slot thread (writer) and the FAPO control
+/// server thread (reader).
+///
+/// A seqlock is used because the writer runs in the real-time slot thread and must never block. Snapshots are
+/// small PODs, so a seqlock with bounded reader retries is adequate.
+class fapo_telemetry_store
+{
+  struct cell_entry {
+    std::atomic<uint32_t> seq{0};
+    fapo_cell_snapshot    snap{};
+  };
+
+public:
+  /// \brief Publish a new snapshot for the given cell. Called from the scheduler slot thread.
+  void publish(du_cell_index_t cell_index, const fapo_cell_snapshot& snap)
+  {
+    cell_entry& e = cells[static_cast<unsigned>(cell_index) % cells.size()];
+    uint32_t    s = e.seq.load(std::memory_order_relaxed);
+    e.seq.store(s + 1, std::memory_order_relaxed); // make it odd -> write in progress
+    std::atomic_thread_fence(std::memory_order_release);
+    e.snap = snap;
+    std::atomic_thread_fence(std::memory_order_release);
+    e.seq.store(s + 2, std::memory_order_relaxed); // make it even -> write complete
+  }
+
+  /// \brief Read the latest snapshot of the given cell. Called from the FAPO control server thread.
+  /// \return true if a complete snapshot was read, false if no snapshot was ever published for this cell.
+  bool read(du_cell_index_t cell_index, fapo_cell_snapshot& out) const
+  {
+    const cell_entry& e = cells[static_cast<unsigned>(cell_index) % cells.size()];
+    for (unsigned attempt = 0; attempt != 8; ++attempt) {
+      uint32_t s1 = e.seq.load(std::memory_order_acquire);
+      if ((s1 & 1U) != 0U or s1 == 0U) {
+        // Write in progress or no snapshot published yet.
+        if (s1 == 0U) {
+          return false;
+        }
+        continue;
+      }
+      out = e.snap;
+      std::atomic_thread_fence(std::memory_order_acquire);
+      uint32_t s2 = e.seq.load(std::memory_order_relaxed);
+      if (s1 == s2) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+private:
+  std::array<cell_entry, MAX_NOF_DU_CELLS> cells;
+};
+
+/// Control command produced by the FAPO control server thread and applied by the scheduler slot thread.
+struct fapo_command {
+  du_cell_index_t cell_index = INVALID_DU_CELL_INDEX;
+  /// Restore the baseline RB limits of all slices of the cell.
+  bool reset = false;
+  /// RAN slice to modify (ignored when \c reset is true).
+  ran_slice_id_t slice_id{};
+  /// New maximum number of RBs granted to the slice.
+  unsigned max_rbs = 0;
+};
+
+/// Shared state between the FAPO control server thread and the scheduler slot threads.
+struct fapo_context {
+  /// Queue capacity for pending control commands.
+  static constexpr unsigned QUEUE_CAPACITY = 1024;
+
+  /// Latest telemetry snapshots (written by slot thread, read by control server).
+  fapo_telemetry_store telemetry;
+  /// Queue of pending control commands (pushed by control server, drained by slot thread).
+  explicit fapo_context(unsigned queue_capacity = QUEUE_CAPACITY) : commands(queue_capacity) {}
+  concurrent_queue<fapo_command, concurrent_queue_policy::lockfree_mpmc> commands;
+};
+
+/// \brief Computes the FAPO wire name of a slice.
+///
+/// Reserved slices use fixed names; configured slices are named after their S-NSSAI. In the (unlikely) case of two
+/// configured slices resolving to the same name, the internal slice id is appended to disambiguate.
+inline void fapo_fill_slice_name(ran_slice_id_t id, const rrm_policy_member& member, span<char> out)
+{
+  int ret = 0;
+  if (id == SRB_RAN_SLICE_ID) {
+    ret = std::snprintf(out.data(), out.size(), "srb");
+  } else if (id == DEFAULT_DRB_RAN_SLICE_ID) {
+    ret = std::snprintf(out.data(), out.size(), "default");
+  } else if (member.s_nssai.sd.is_set()) {
+    ret = std::snprintf(
+        out.data(), out.size(), "sst%u-sd%#x", member.s_nssai.sst.value(), member.s_nssai.sd.value());
+  } else {
+    ret = std::snprintf(out.data(), out.size(), "sst%u", member.s_nssai.sst.value());
+  }
+  if (ret < 0 or static_cast<unsigned>(ret) >= out.size()) {
+    // Name does not fit. Fall back to the internal slice id.
+    std::snprintf(out.data(), out.size(), "slice%u", id.value());
+  }
+}
+
+/// \brief Maps the slice SST to the FAPO slice type reported over the control protocol.
+/// \remark The mapping follows the standardized SST values of TS 23.501: 1 = eMBB, 2 = URLLC.
+inline const char* fapo_slice_type_of_sst(uint8_t sst)
+{
+  if (sst == 2U) {
+    return "rll";
+  }
+  if (sst == 1U) {
+    return "high_capacity";
+  }
+  return "best_effort";
+}
