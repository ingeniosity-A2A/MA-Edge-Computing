+namespace srsran {
+
+/// \brief FAPO control server.
+///
+/// Exposes the FAPO control protocol (JSON Lines over TCP or Unix socket, version 1) on a dedicated non
+/// real-time thread:
+///
+///   - \c hello:        protocol handshake.
+///   - \c get_telemetry: latest per-slice scheduler telemetry and effective slice policies.
+///   - \c apply:        request a new maximum number of RBs for one or more slices. The commands are enqueued
+///                      and applied by the scheduler slot thread at the next slot indication.
+///   - \c reset:        restore the baseline RB limits of the slices of all active cells.
+///   - \c ping:         liveness check.
+///
+/// The radio remains the source of truth: the applied policies are reported back in the \c policies block of
+/// the telemetry, and clients must use them as the effective scheduling bounds.
+class fapo_control_server
+{
+public:
+  fapo_control_server(const fapo_control_expert_config& cfg_, fapo_context& ctx_);
+  ~fapo_control_server();
+
+private:
+  /// Per-client connection state.
+  struct client_state {
+    int         fd     = -1;
+    std::string inbuf;  ///< Partially received request line.
+    std::string outbuf; ///< Pending response bytes not yet sent.
+  };
+
+  /// Thread body: socket listen/accept/read/write loop.
+  void run();
+
+  /// \brief Processes one request line and returns the response to send (without the newline).
+  /// \param line Request line (JSON object).
+  /// \param[out] close_client Set to true if the connection must be closed after the response.
+  std::string handle_line(const std::string& line, bool& close_client);
+
+  /// Builds the telemetry payload for the reply of a \c get_telemetry operation.
+  std::string build_telemetry_json();
+
+  /// Reads the latest snapshot across all cells, merging slices of multiple cells if needed.
+  /// \return true if at least one active cell snapshot was available.
+  bool read_merged_snapshot(fapo_cell_snapshot& merged, unsigned& nof_active_cells);
+
+  const fapo_control_expert_config cfg;
+  fapo_context&                    ctx;
+  srslog::basic_logger&            logger;
+
+  std::atomic<bool> stop_flag{false};
+  std::thread       ctrl_thread;
+
+  /// Listening socket descriptor (tcp or unix), or -1 when not listening.
+  int listen_fd = -1;
+  /// Path of the unix socket, to unlink on shutdown (empty for tcp).
+  std::string unix_sock_path;
+};
+
+} // namespace srsran
