+fapo_control_server::fapo_control_server(const fapo_control_expert_config& cfg_, fapo_context& ctx_) :
+  cfg(cfg_), ctx(ctx_), logger(srslog::fetch_basic_logger("FAPO"))
+{
+  ctrl_thread = std::thread([this]() { run(); });
+}
+
+fapo_control_server::~fapo_control_server()
+{
+  stop_flag.store(true, std::memory_order_release);
+  if (ctrl_thread.joinable()) {
+    ctrl_thread.join();
+  }
+}
+
+static int open_listen_tcp(const char* host, unsigned port, srslog::basic_logger& logger)
+{
+  struct addrinfo hints{};
+  hints.ai_family   = AF_UNSPEC;
+  hints.ai_socktype = SOCK_STREAM;
+  hints.ai_flags    = AI_PASSIVE | AI_NUMERICHOST;
+  hints.ai_protocol = IPPROTO_TCP;
+
+  char port_str[8];
+  std::snprintf(port_str, sizeof(port_str), "%u", port);
+
+  struct addrinfo* res = nullptr;
+  int                    rc  = ::getaddrinfo(host, port_str, &hints, &res);
+  if (rc != 0 or res == nullptr) {
+    // Retry allowing name resolution (e.g. "localhost").
+    hints.ai_flags = AI_PASSIVE;
+    rc             = ::getaddrinfo(host, port_str, &hints, &res);
+    if (rc != 0 or res == nullptr) {
+      logger.error("FAPO control server: failed to resolve listen address \"{}:{}\"", host, port);
+      return -1;
+    }
+  }
+
+  int fd = -1;
+  for (struct addrinfo* ai = res; ai != nullptr; ai = ai->ai_next) {
+    fd = ::socket(ai->ai_family, ai->ai_socktype, ai->ai_protocol);
+    if (fd < 0) {
+      continue;
+    }
+    int one = 1;
+    ::setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+    if (::bind(fd, ai->ai_addr, ai->ai_addrlen) == 0 and ::listen(fd, 8) == 0) {
+      break;
+    }
+    ::close(fd);
+    fd = -1;
+  }
+  ::freeaddrinfo(res);
+
+  if (fd >= 0) {
+    logger.info("FAPO control server: listening on tcp://{}:{}", host, port);
+  } else {
+    logger.error("FAPO control server: failed to bind tcp://{}:{}. Cause: {}", host, port, strerror(errno));
+  }
+  return fd;
+}
+
+static int open_listen_unix(const char* path, srslog::basic_logger& logger)
+{
+  int fd = ::socket(AF_UNIX, SOCK_STREAM, 0);
+  if (fd < 0) {
+    logger.error("FAPO control server: failed to create unix socket. Cause: {}", strerror(errno));
+    return -1;
+  }
+  struct sockaddr_un addr{};
+  addr.sun_family = AF_UNIX;
+  std::strncpy(addr.sun_path, path, sizeof(addr.sun_path) - 1);
+  ::unlink(path);
+  if (::bind(fd, reinterpret_cast<struct sockaddr*>(&addr), sizeof(addr)) != 0 or ::listen(fd, 8) != 0) {
+    logger.error("FAPO control server: failed to bind unix://{}. Cause: {}", path, strerror(errno));
+    ::close(fd);
+    return -1;
+  }
+  logger.info("FAPO control server: listening on unix://{}", path);
+  return fd;
+}
