+void inter_slice_scheduler::fapo_collect_cell_snapshot(fapo_cell_snapshot& snapshot) const
+{
+  snapshot.active     = true;
+  snapshot.pci        = cell_cfg.pci;
+  snapshot.prbs_total = cell_cfg.dl_cfg_common.init_dl_bwp.generic_params.crbs.length();
+  snapshot.slots_per_sec =
+      1000U * (1U << to_numerology_value(cell_cfg.scs_common));
+  snapshot.scs_khz    = scs_to_khz(cell_cfg.scs_common);
+  snapshot.nof_slices = 0;
+
+  for (const auto& slice : slices) {
+    if (snapshot.nof_slices >= snapshot.slices.size()) {
+      logger.warning("cell={}: Discarding FAPO telemetry of slices beyond the first {} slices.",
+                     fmt::underlying(cell_cfg.cell_index),
+                     snapshot.slices.size());
+      break;
+    }
+
+    fapo_slice_snapshot& s = snapshot.slices[snapshot.nof_slices];
+    s.id                   = slice.inst.id;
+    fapo_fill_slice_name(slice.inst.id, slice.inst.cfg.rrc_member, span<char>{s.name.data(), s.name.size()});
+    s.priority         = slice.inst.cfg.priority;
+    s.min_prbs         = slice.inst.cfg.rbs.min();
+    s.max_prbs         = slice.inst.cfg.rbs.max();
+    s.dedicated_prbs   = slice.inst.cfg.rbs.dedicated();
+    s.avg_dl_rbs_per_slot = slice.inst.average_pdsch_rbs_per_slot();
+    s.avg_ul_rbs_per_slot = slice.inst.average_pusch_rbs_per_slot();
+
+    unsigned pending_dl = 0;
+    unsigned pending_ul = 0;
+    unsigned nof_ues    = 0;
+    for (const auto& slice_ue_it : slice.inst.get_ues()) {
+      pending_dl += slice_ue_it.pending_dl_newtx_bytes();
+      pending_ul += slice_ue_it.pending_ul_newtx_bytes();
+      ++nof_ues;
+    }
+    s.pending_dl_bytes = pending_dl;
+    s.pending_ul_bytes = pending_ul;
+    s.nof_ues          = nof_ues;
+    s.sst              = slice.inst.cfg.rrc_member.s_nssai.sst.value();
+
+    ++snapshot.nof_slices;
+  }
+}
+
+bool inter_slice_scheduler::fapo_apply_slice_max_rbs(ran_slice_id_t slice_id, unsigned max_rbs)
+{
+  if (slice_id.value() >= slices.size()) {
+    return false;
+  }
+  ran_slice_instance& slice = slices[slice_id.value()].inst;
+
+  const unsigned cell_max_rbs = cell_cfg.dl_cfg_common.init_dl_bwp.generic_params.crbs.length();
+  const unsigned new_max      = std::min(std::max(max_rbs, 1U), cell_max_rbs);
+  const unsigned new_min      = std::min(slice.cfg.rbs.min(), new_max);
+  const unsigned new_ded      = std::min(slice.cfg.rbs.dedicated(), new_min);
+
+  logger.info("cell={} slice={}: FAPO changing slice max RBs: {} -> {} (min: {}, dedicated: {})",
+              fmt::underlying(cell_cfg.cell_index),
+              slice.id.value(),
+              slice.cfg.rbs.max(),
+              new_max,
+              new_min,
+              new_ded);
+
+  slice.cfg.rbs = {new_ded, new_min, new_max};
+  return true;
+}
+
+void inter_slice_scheduler::fapo_reset_slice_policies_to_baseline()
+{
+  for (auto& slice : slices) {
+    if (slice.inst.cfg.rbs.max() != slice.inst.cfg_baseline.rbs.max() or
+        slice.inst.cfg.rbs.min() != slice.inst.cfg_baseline.rbs.min()) {
+      logger.info("cell={} slice={}: FAPO restoring baseline slice RB limits (max: {} -> {})",
+                  fmt::underlying(cell_cfg.cell_index),
+                  slice.inst.id.value(),
+                  slice.inst.cfg.rbs.max(),
+                  slice.inst.cfg_baseline.rbs.max());
+      slice.inst.cfg.rbs = slice.inst.cfg_baseline.rbs;
+    }
+  }
+}
