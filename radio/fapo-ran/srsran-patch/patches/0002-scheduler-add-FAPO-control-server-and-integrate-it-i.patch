+// -------------------------------------------------------------------------------------------
+// Minimal JSON value tree and parser (no exceptions, no external dependencies).
+// -------------------------------------------------------------------------------------------
+
+struct jval {
+  enum class type_t { nul, boolean, number, str, arr, obj };
+
+  type_t                                     type = type_t::nul;
+  bool                                       b    = false;
+  double                                     num  = 0;
+  std::string                                str;
+  std::vector<jval>                          arr;
+  std::vector<std::pair<std::string, jval>>  obj;
+
+  const jval* find(const char* key) const
+  {
+    if (type != type_t::obj) {
+      return nullptr;
+    }
+    for (const auto& kv : obj) {
+      if (kv.first == key) {
+        return &kv.second;
+      }
+    }
+    return nullptr;
+  }
+};
+
+/// Minimal recursive-descent JSON parser. Returns false on malformed input.
+struct jparser {
+  const char* p;
+  const char* end;
+
+  bool parse(jval& out)
+  {
+    skip_ws();
+    if (!parse_value(out)) {
+      return false;
+    }
+    skip_ws();
+    return p == end;
+  }
+
+  void skip_ws()
+  {
+    while (p != end and (*p == ' ' or *p == '\t' or *p == '\r' or *p == '\n')) {
+      ++p;
+    }
+  }
+
+  bool parse_value(jval& out)
+  {
+    if (p == end) {
+      return false;
+    }
+    switch (*p) {
+      case '{':
+        return parse_obj(out);
+      case '[':
+        return parse_arr(out);
+      case '"': {
+        out.type = jval::type_t::str;
+        return parse_string(out.str);
+      }
+      case 't':
+        return parse_lit("true", out, jval::type_t::boolean, true);
+      case 'f':
+        return parse_lit("false", out, jval::type_t::boolean, false);
+      case 'n':
+        return parse_lit("null", out, jval::type_t::nul, false);
+      default:
+        return parse_num(out);
+    }
+  }
+
+  bool parse_lit(const char* lit, jval& out, jval::type_t t, bool bval)
+  {
+    size_t len = std::strlen(lit);
+    if (static_cast<size_t>(end - p) < len or std::memcmp(p, lit, len) != 0) {
+      return false;
+    }
+    p += len;
+    out.type = t;
+    out.b    = bval;
+    return true;
+  }
+
+  bool parse_num(jval& out)
+  {
+    char*        endptr = nullptr;
+    const char*  start  = p;
+    double       v      = std::strtod(start, &endptr);
+    if (endptr == start) {
+      return false;
+    }
+    // strtod may read beyond the buffer end if the number is at the very end of a non-null-terminated region.
+    // The input buffer is guaranteed to be null-terminated by the caller, so this is safe.
+    p        = endptr;
+    out.type = jval::type_t::number;
+    out.num  = v;
+    return true;
+  }
+
+  bool parse_string(std::string& out)
+  {
+    if (p == end or *p != '"') {
+      return false;
+    }
+    ++p;
+    out.clear();
+    while (p != end) {
+      char c = *p++;
+      if (c == '"') {
+        return true;
+      }
+      if (c != '\\') {
+        out.push_back(c);
+        continue;
+      }
+      if (p == end) {
+        return false;
+      }
+      char esc = *p++;
+      switch (esc) {
+        case '"':
+          out.push_back('"');
+          break;
+        case '\\':
+          out.push_back('\\');
+          break;
+        case '/':
+          out.push_back('/');
+          break;
+        case 'b':
+          out.push_back('\b');
+          break;
+        case 'f':
+          out.push_back('\f');
+          break;
+        case 'n':
+          out.push_back('\n');
+          break;
+        case 'r':
+          out.push_back('\r');
+          break;
+        case 't':
+          out.push_back('\t');
+          break;
+        case 'u': {
+          if (end - p < 4) {
+            return false;
+          }
+          unsigned cp = 0;
+          for (unsigned i = 0; i != 4; ++i) {
+            char  h  = *p++;
+            cp      = (cp << 4U) + (h >= '0' and h <= '9' ? static_cast<unsigned>(h - '0')
+                                                          : (h >= 'a' and h <= 'f' ? static_cast<unsigned>(h - 'a' + 10)
+                                                                                   : (h >= 'A' and h <= 'F' ? static_cast<unsigned>(h - 'A' + 10)
+                                                                                                            : 0xFFFFFFFFU)));
+            if (cp == 0xFFFFFFFFU) {
+              return false;
+            }
+          }
+          // Encode the codepoint as UTF-8 (surrogate pairs are not required for the FAPO protocol).
+          if (cp < 0x80U) {
+            out.push_back(static_cast<char>(cp));
+          } else if (cp < 0x800U) {
+            out.push_back(static_cast<char>(0xC0U | (cp >> 6U)));
+            out.push_back(static_cast<char>(0x80U | (cp & 0x3FU)));
+          } else {
+            out.push_back(static_cast<char>(0xE0U | (cp >> 12U)));
+            out.push_back(static_cast<char>(0x80U | ((cp >> 6U) & 0x3FU)));
+            out.push_back(static_cast<char>(0x80U | (cp & 0x3FU)));
+          }
+          break;
+        }
+        default:
+          return false;
+      }
+    }
+    return false;
+  }
+
+  bool parse_arr(jval& out)
+  {
+    out.type = jval::type_t::arr;
+    ++p; // consume '['
+    skip_ws();
+    if (p != end and *p == ']') {
+      ++p;
+      return true;
+    }
+    while (true) {
+      skip_ws();
+      out.arr.emplace_back();
+      if (!parse_value(out.arr.back())) {
+        return false;
+      }
+      skip_ws();
+      if (p == end) {
+        return false;
+      }
+      if (*p == ',') {
+        ++p;
+        continue;
+      }
+      if (*p == ']') {
+        ++p;
+        return true;
+      }
+      return false;
+    }
+  }
+
+  bool parse_obj(jval& out)
+  {
+    out.type = jval::type_t::obj;
+    ++p; // consume '{'
+    skip_ws();
+    if (p != end and *p == '}') {
+      ++p;
+      return true;
+    }
+    while (true) {
+      skip_ws();
+      std::string key;
+      if (!parse_string(key)) {
+        return false;
+      }
+      skip_ws();
+      if (p == end or *p != ':') {
+        return false;
+      }
+      ++p;
+      skip_ws();
+      jval item;
+      if (!parse_value(item)) {
+        return false;
+      }
+      out.obj.emplace_back(std::move(key), std::move(item));
+      skip_ws();
+      if (p == end) {
+        return false;
+      }
+      if (*p == ',') {
+        ++p;
+        continue;
+      }
+      if (*p == '}') {
+        ++p;
+        return true;
+      }
+      return false;
+    }
+  }
+};
+
+// -------------------------------------------------------------------------------------------
+// JSON writing helpers.
+// -------------------------------------------------------------------------------------------
+
+void json_escape(fmt::memory_buffer& buf, const std::string& s)
+{
+  buf.push_back('"');
+  for (char c : s) {
+    switch (c) {
+      case '"':
+        fmt::format_to(fmt::appender(buf), "\\\"");
+        break;
+      case '\\':
+        fmt::format_to(fmt::appender(buf), "\\\\");
+        break;
+      case '\n':
+        fmt::format_to(fmt::appender(buf), "\\n");
+        break;
+      case '\r':
+        fmt::format_to(fmt::appender(buf), "\\r");
+        break;
+      case '\t':
+        fmt::format_to(fmt::appender(buf), "\\t");
+        break;
+      default:
+        if (static_cast<unsigned char>(c) < 0x20U) {
+          fmt::format_to(fmt::appender(buf), "\\u{:04x}", c);
+        } else {
+          buf.push_back(c);
+        }
+    }
+  }
+  buf.push_back('"');
+}
+
+/// Formats a double that represents a protocol request id: integers without a decimal part.
+void fmt_request_id(fmt::memory_buffer& buf, double id)
+{
+  if (id == static_cast<double>(static_cast<long long>(id)) and std::fabs(id) < 9.0e15) {
+    fmt::format_to(fmt::appender(buf), "{}", static_cast<long long>(id));
+    return;
+  }
+  fmt::format_to(fmt::appender(buf), "{}", id);
+}
