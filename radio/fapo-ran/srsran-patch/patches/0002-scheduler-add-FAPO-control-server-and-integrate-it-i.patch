+void ue_scheduler_impl::fapo_publish_snapshot(cell_context& cell, du_cell_index_t cell_index, slot_point sl_tx)
+{
+  if (fapo_ctx == nullptr) {
+    return;
+  }
+
+  const unsigned slots_per_sec = 1000U * (1U << to_numerology_value(cell.cell_res_alloc->cfg.scs_common));
+  const unsigned period_slots =
+      std::max(1U, static_cast<unsigned>(fapo_telemetry_period.count() * static_cast<long long>(slots_per_sec) / 1000));
+
+  const slot_point& last_pub = fapo_last_pub_slot[static_cast<unsigned>(cell_index)];
+  if (last_pub.valid() and static_cast<unsigned>(sl_tx - last_pub) < period_slots) {
+    return;
+  }
+  fapo_last_pub_slot[static_cast<unsigned>(cell_index)] = sl_tx;
+
+  fapo_cell_snapshot snap;
+  cell.slice_sched.fapo_collect_cell_snapshot(snap);
+  snap.nof_dl_harq_acks  = cell.ev_mng->fapo_nof_dl_harq_acks();
+  snap.nof_dl_harq_nacks = cell.ev_mng->fapo_nof_dl_harq_nacks();
+  fapo_ctx->telemetry.publish(cell_index, snap);
+}
