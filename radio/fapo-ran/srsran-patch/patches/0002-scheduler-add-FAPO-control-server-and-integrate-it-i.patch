+void ue_scheduler_impl::fapo_drain_commands(slot_point sl_tx [[maybe_unused]])
+{
+  if (fapo_ctx == nullptr) {
+    return;
+  }
+
+  fapo_command cmd;
+  for (unsigned drained = 0; drained != FAPO_MAX_CMDS_PER_SLOT; ++drained) {
+    if (not fapo_ctx->commands.try_pop(cmd)) {
+      return;
+    }
+
+    if (cells.contains(cmd.cell_index)) {
+      // Command belongs to a cell of this cell group. Apply it directly, as this code runs in the slot thread
+      // that owns the slice scheduler state.
+      auto& cell = cells[cmd.cell_index];
+      if (cmd.reset) {
+        cell.slice_sched.fapo_reset_slice_policies_to_baseline();
+        logger.info("cell={}: FAPO restored baseline slice policies.",
+                    fmt::underlying(cmd.cell_index));
+      } else if (not cell.slice_sched.fapo_apply_slice_max_rbs(cmd.slice_id, cmd.max_rbs)) {
+        logger.warning("cell={}: FAPO apply for unknown slice id={}.",
+                       fmt::underlying(cmd.cell_index),
+                       cmd.slice_id.value());
+      }
+      continue;
