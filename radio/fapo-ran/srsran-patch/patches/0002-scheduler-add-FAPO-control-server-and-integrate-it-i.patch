+/// FAPO control protocol version implemented by this server.
+constexpr unsigned FAPO_PROTOCOL_VERSION = 1;
+
+/// Server name reported in the hello response (matches the FAPO v1 protocol definition).
+constexpr const char* FAPO_SERVER_NAME = "srsran-fapo-control";
+
+/// Maximum size of a partially received request line before the client is disconnected.
+constexpr size_t FAPO_MAX_LINE_SIZE = 1U << 20;
