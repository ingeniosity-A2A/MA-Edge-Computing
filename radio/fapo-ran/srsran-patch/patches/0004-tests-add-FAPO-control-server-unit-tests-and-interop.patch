+/// \file
+/// \brief Cross-language interop test fixture for the FAPO control server.
+///
+/// This is a TEST HARNESS, not part of the gNB: it instantiates the real
+/// \c fapo_control_server (the same class that runs inside the patched scheduler) and
+/// publishes deterministic telemetry snapshots from a background thread, emulating the
+/// slot-thread publisher. External clients (e.g. the Python \c SRSRANAdapter) can then
+/// drive the full FAPO v1 protocol against the real server implementation.
+///
+/// The applied commands are drained and echoed to stdout so test clients can verify the
+/// scheduler-side effect.
+
+#include "../../../lib/scheduler/fapo/fapo_control_server.h"
+#include "srsran/srslog/srslog.h"
+#include <atomic>
+#include <chrono>
+#include <csignal>
+#include <cstdio>
+#include <thread>
+
+using namespace srsran;
+
+static std::atomic<bool> g_stop{false};
+
+static void signal_handler(int)
+{
+  g_stop.store(true);
+}
+
+int main(int argc, char** argv)
+{
+  if (argc < 2) {
+    fmt::print("usage: {} <endpoint> [runtime_seconds]\n", argv[0]);
+    return 1;
+  }
+  const std::string endpoint = argv[1];
+  const unsigned    runtime_s = argc > 2 ? static_cast<unsigned>(std::atoi(argv[2])) : 30;
+
+  srslog::init();
+
+  fapo_control_expert_config cfg;
+  cfg.enabled  = true;
+  cfg.endpoint = endpoint;
+
+  fapo_context ctx(1024);
+
+  fapo_control_server server(cfg, ctx);
+
+  // Background thread emulating the scheduler slot-thread publisher: publishes a snapshot
+  // of a cell with two slices (default DRB + SST2/SD0xa) and applies drained commands.
+  std::thread worker([&ctx, &g_stop]() {
+    fapo_cell_snapshot snap;
+    snap.active       = true;
+    snap.pci          = 1;
+    snap.prbs_total   = 51;
+    snap.slots_per_sec = 2000;
+    snap.scs_khz      = 30;
+
+    fapo_slice_snapshot& drb = snap.slices[snap.nof_slices++];
+    drb.id                   = DEFAULT_DRB_RAN_SLICE_ID;
+    std::snprintf(drb.name.data(), drb.name.size(), "default");
+    drb.min_prbs = 0;
+    drb.max_prbs = 51;
+    drb.sst      = 0;
+
+    fapo_slice_snapshot& sst2 = snap.slices[snap.nof_slices++];
+    sst2.id                   = ran_slice_id_t{2};
+    std::snprintf(sst2.name.data(), sst2.name.size(), "sst2-sd0xa");
+    sst2.priority = 8;
+    sst2.min_prbs = 5;
+    sst2.max_prbs = 20;
+    sst2.sst      = 2;
+
+    unsigned tick = 0;
+    while (not g_stop.load()) {
+      // Slowly vary the queue fill so clients can observe motion.
+      unsigned pend            = 40000 + (tick % 100) * 1000;
+      sst2.pending_dl_bytes    = pend;
+      sst2.pending_ul_bytes    = pend / 2;
+      sst2.nof_ues             = 2;
+      sst2.avg_dl_rbs_per_slot = 4.5F;
+      snap.nof_dl_harq_acks    = 900;
+      snap.nof_dl_harq_nacks   = 100;
+
+      ctx.telemetry.publish(to_du_cell_index(0), snap);
+
+      // Drain commands like the scheduler slot thread would.
+      fapo_command cmd;
+      while (ctx.commands.try_pop(cmd)) {
+        if (cmd.reset) {
+          fmt::print("APPLIED_RESET cell={}\n", static_cast<unsigned>(cmd.cell_index));
+        } else {
+          fmt::print("APPLIED cell={} slice={} max_rbs={}\n",
+                     static_cast<unsigned>(cmd.cell_index),
+                     cmd.slice_id.value(),
+                     cmd.max_rbs);
+        }
+        std::fflush(stdout);
+      }
+
+      ++tick;
+      std::this_thread::sleep_for(std::chrono::milliseconds{50});
+    }
+  });
+
+  std::signal(SIGINT, signal_handler);
+  std::signal(SIGTERM, signal_handler);
+
+  auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds{runtime_s};
+  while (not g_stop.load() and std::chrono::steady_clock::now() < deadline) {
+    std::this_thread::sleep_for(std::chrono::milliseconds{100});
+  }
+
+  worker.join();
+  return 0;
+}
